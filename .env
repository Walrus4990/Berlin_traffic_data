# ---- DDWEB login
DDWEB_EMAIL=any.flounder310@passinbox.com
DDWEB_PASSWORD=qODdls4_!M

# ---- DOCKER COMPOSE PROFILE ----
# determines which profile will be active. It's like a switch between local and full.

# local = PostgreSQL + Superset only - for local work
# full  = everything including Airflow + MinIO - to set up on the VM
COMPOSE_PROFILES=full

# ---- PostgreSQL: Traffic data ----
POSTGRES_TRAFFIC_USER=traffic
POSTGRES_TRAFFIC_PASSWORD=traffic
POSTGRES_TRAFFIC_DB=berlin_traffic

# ---- PostgreSQL: Data quality ----
POSTGRES_DQ_USER=dq
POSTGRES_DQ_PASSWORD=dq
POSTGRES_DQ_DB=data_quality

# ---- PostgreSQL: Airflow metadata ----
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=airflow
POSTGRES_AIRFLOW_DB=airflow

# ---- MinIO (full profile only) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=berlin-traffic-raw

# ---- Superset ----
SUPERSET_SECRET_KEY=admin
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
POSTGRES_TRAFFIC_HOST=localhost
POSTGRES_TRAFFIC_PORT=5431
