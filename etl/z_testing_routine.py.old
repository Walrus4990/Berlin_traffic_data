from datetime import date

import etl.ddweb_auth as auth
from etl.ddweb_ingest_ref import fetch_missions, fetch_locations
import etl.ddweb_ingest_traffic as traffic


# --- Authenticate ---
client = auth.DDWebAuth()
client.ensure_authenticated()

# --- Fetch missions ---
missions_df = fetch_missions(client)
locations_df = fetch_locations(client)

print(missions_df[["Id", "FromDate", "ToDate", "LocationTitle"]])
print(missions_df.dtypes)
print(locations_df[["Id", "LocationTitle", "Created"]])
print(locations_df.dtypes)


# # =========================
# # TEST CASE - test minio in bronze layer
# # =========================

from etl.bronze_data_layer import ingest_traffic
from utils.db import get_traffic_engine

with get_traffic_engine() as engine:
    rows = ingest_traffic(engine)
    print(f"Rows loaded: {rows}")

# # =========================
# # TEST CASE - test minio
# # =========================

mission_id = 40671
row = missions_df[missions_df["Id"] == mission_id].iloc[0]
from_date = traffic.parse_date(row["FromDate"])
to_date = traffic.parse_date(row["ToDate"])
test_chunks = traffic._get_month_chunks(from_date, to_date)
chunk_start, chunk_end = test_chunks[0]
payload = traffic._build_payload(mission_id, chunk_start, chunk_end)
analysis_id = traffic._do_analyze(client.session, mission_id, payload)
traffic._get_partial_result(client.session, analysis_id)
file_guid, file_name = traffic._get_file_metadata(client.session, analysis_id)
result = traffic._download_into_parquet(
    client.session,
    file_guid,
    mission_id,
    chunk_start,
    chunk_end,
)
print(result)


