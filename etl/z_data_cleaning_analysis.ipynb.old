      ],
      "text/plain": [
       "                            source_file            datum_raw  \\\n",
       "0  DDweb_VI_Rohdaten_01042026_1726.xlsx  2026-03-25 00:19:54   \n",
       "1  DDweb_VI_Rohdaten_01042026_1726.xlsx  2026-03-25 00:21:52   \n",
       "2  DDweb_VI_Rohdaten_01042026_1726.xlsx  2026-03-25 00:51:22   \n",
