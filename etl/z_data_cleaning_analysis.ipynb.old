    "# ── QA accumulator ──────────────────────────────────────────────────────────\n",
    "# We populate this dict throughout the notebook; it is printed as a report at the end.\n",
    "qa_report = {}\n",
    "\n",
    "print(\"Configuration loaded.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 110,
   "id": "c6b727d4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Auftrag rows: 44\n",
      "Unique device IDs in Auftrag: 30\n"
     ]
    }
   ],
   "source": [
    "# Ensure date columns are proper datetimes, not strings\n",
    "df_Auftrag[\"Startdatum\"] = pd.to_datetime(df_Auftrag[\"Startdatum\"], errors=\"coerce\")\n",
    "df_Auftrag[\"Enddatum\"]   = pd.to_datetime(df_Auftrag[\"Enddatum\"],   errors=\"coerce\")\n",
    "\n",
    "#the Startdatum column — the date each deployment began. That range makes perfect sense: the oldest sensor was first deployed in 2017,\n",
    "#and the most recently started deployment kicked off in March 2026.\n",
    "#Sentinel dates used in Auftrag to mean \"deployment still active\"\n",
    "ACTIVE_SENTINELS = {\n",
    "    pd.Timestamp(\"2049-01-01\"),\n",
    "    pd.Timestamp(\"2100-01-01\"),\n",
    "}\n",
    "\n",
    "df_Auftrag[\"is_active\"] = df_Auftrag[\"Enddatum\"].apply(\n",
    "    lambda d: any(abs((d - s).days) < 2 for s in ACTIVE_SENTINELS) if pd.notna(d) else False\n",
    ")\n",
    "df_Auftrag[\"Enddatum_clean\"] = df_Auftrag.apply(\n",
    "    lambda row: pd.NaT if row[\"is_active\"] else row[\"Enddatum\"], axis=1\n",
    ")\n",
    "\n",
    "print(f\"Auftrag rows: {len(df_Auftrag)}\")\n",
    "print(f\"Unique device IDs in Auftrag: {df_Auftrag['Geräte-ID'].nunique()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 111,
   "id": "4306fab3",
   "metadata": {},
   "outputs": [
