    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "ROOT = Path.cwd()\n",
    "if ROOT.name == \"common\":\n",
    "    ROOT = ROOT.parent\n",
    "\n",
    "DATA_DIR = ROOT / \"data\" / \"DDWEB_Downloads\"\n",
    "excel_files = sorted(DATA_DIR.glob(\"*.xlsx\"))\n",
    "\n",
    "print(f\"Found {len(excel_files)} Excel files\")\n",
    "for f in excel_files:\n",
    "    print(f.name)"
   ]
  },
