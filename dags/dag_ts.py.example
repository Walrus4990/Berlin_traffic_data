# Airflow DAG orchestrating the pipeline

from airflow import DAG
from airflow.operators.python import PythonOperator
from airflow.providers.postgres.operators.postgres import PostgresOperator
from datetime import datetime

# --- Task functions ---
def extract_data(**kwargs):
    # Example: pull from API or source DB
    print("Extracting data...")
    # You would return or store data in XCom / staging

def transform_data(**kwargs):
    print("Transforming data...")
    # Clean, aggregate, reshape

def load_data(**kwargs):
    print("Loading data into warehouse...")
    # Insert into Postgres / Snowflake / BigQuery

def refresh_superset_cache(**kwargs):
    print("Triggering Superset cache refresh...")
    # Could call Superset API to refresh dataset/dashboard cache

# --- DAG definition ---
with DAG(
    dag_id="superset_dashboard_pipeline",
    start_date=datetime(2025, 1, 1),
    schedule_interval="@daily",
    catchup=False,
    tags=["analytics", "superset"],
) as dag:

    extract = PythonOperator(
        task_id="extract_data",
        python_callable=extract_data,
    )

    transform = PythonOperator(
        task_id="transform_data",
        python_callable=transform_data,
    )

    load = PythonOperator(
        task_id="load_data",
        python_callable=load_data,
    )

    # Example: run SQL to update a materialized view used in Superset
    update_view = PostgresOperator(
        task_id="update_materialized_view",
        postgres_conn_id="postgres_default",
        sql="""
        REFRESH MATERIALIZED VIEW my_dashboard_view;
        """,
    )

    refresh_cache = PythonOperator(
        task_id="refresh_superset_cache",
        python_callable=refresh_superset_cache,
    )

    # --- DAG dependencies (this is the "DAG block") ---
    extract >> transform >> load >> update_view >> refresh_cache
